# Domain name for automatic Let's Encrypt HTTPS via Caddy (e.g., node.example.com)
# Leave as localhost for local self-signed testing.
MONERO_DOMAIN=localhost

# Allowed CORS origin for browser wallets (use * for any browser wallet, or https://monkstash.com)
CORS_ORIGIN=*

# Container image tag (sethsimmons/simple-monerod)
MONERO_VERSION=latest

# Mainnet Ports
P2P_PORT=18080
RPC_BIND_IP=127.0.0.1
RPC_RESTRICTED_PORT=18089

# Stagenet Ports
STAGENET_P2P_PORT=38080
STAGENET_RPC_BIND_IP=0.0.0.0
STAGENET_RPC_PORT=38089
